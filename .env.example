DEBUG=True
SECRET_KEY=django-insecure-realsuccess-super-secret-key-change-in-production-1234567890
BASE_URL=http://localhost:8003
APP_NAME="Real Success"
ADMIN_ACCESS_EMAILS=admin@example.com

# Database Configuration
POSTGRES_DB=realsuccess_db
POSTGRES_USER=realsuccess_user
POSTGRES_PASSWORD=realsuccess_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Allowed Hosts
ALLOWED_HOSTS_DEV=localhost,127.0.0.1,0.0.0.0,web
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Development - smtp4dev)
EMAIL_HOST_DEV=smtp4dev
EMAIL_PORT_DEV=25
EMAIL_USE_TLS_DEV=False
EMAIL_HOST_USER_DEV=
EMAIL_HOST_PASSWORD_DEV=
DEFAULT_FROM_EMAIL_DEV=no-reply@realsuccess.com

# Email Configuration (Production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@realsuccess.com

# Brevo (Optional)
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@realsuccess.com
BREVO_FROM_NAME="Real Success"

# Social Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
APPLE_CALLBACK_URL=
